{
    "python": {
        "module": "tree_sitter_python",
        "factory": "language",
        "exts": [".py", ".pyi"],
        "functions": ["function_definition"],
        "classes": ["class_definition"],
        "imports": ["import_statement", "import_from_statement", "type"],
        "identifiers": ["identifier"],
        "not_var_ptype": [
            "function_definition",
            "class_definition",
            "call",
            "import_statement",
            "import_from_statement",
            "aliased_import",
            "attribute",
            "keyword_argument",
            "type",
            "typed_parameter",
            "literal_element"
        ],
        "comparisons": ["comparison_operator", "boolean_operator"],
        "if_conditions": ["if_statement"],
        "else_conditions": ["else_statement", "else_clause"],
        "alternative_conditions": ["elif_statement", "elif_clause"],
        "condition_blocks": ["block"]
    },
    "go": {
        "module": "tree_sitter_go",
        "factory": "language",
        "exts": [".go"],
        "functions": ["function_declaration", "method_declaration"],
        "classes": [],
        "imports": ["import_declaration", "type"],
        "identifiers": ["identifier"],
        "not_var_ptype": [
            "function_declaration",
            "method_declaration",
            "call_expression",
            "import_declaration",
            "import_spec",
            "class_declaration", 
            "function_definition",  
            "call", 
            "local_function_statement",
            "package_clause",
            "type_declaration",
            "type_spec",
            "field_declaration",
            "method_elem",
            "field_identifier",
            "literal_element",
            "selector_expression"
        ],
        "comparisons": ["binary_expression"],
        "if_conditions": ["if_statement"],
        "else_conditions": ["else"],
        "alternative_conditions": ["if_statement"],
        "condition_blocks": ["block"]
    },
    "javascript": {
        "module": "tree_sitter_javascript",
        "factory": "language",
        "exts": [".js", ".jsx", ".mjs", ".cjs"],
        "functions": [
            "function_declaration",
            "generator_function_declaration",
            "function_expression",
            "function",             
            "generator_function",    
            "arrow_function",
            "method_definition"
        ],
        "classes": ["class_declaration", "class"],
        "imports": ["import_statement"],
        "identifiers": ["identifier", "type"],
        "not_var_ptype": [
            "function_declaration",
            "function_expression",
            "generator_function",
            "generator_function_declaration",
            "method_definition",
            "class_declaration",
            "class",
            "call_expression",
            "new_expression",
            "import_statement",
            "import_specifier",
            "namespace_import",
            "member_expression",
            "pair",
            "statement_block",
            "literal_element"
        ],
        "comparisons": ["binary_expression"],
        "if_conditions": ["if_statement"],
        "else_conditions": ["else", "else_clause"],
        "alternative_conditions": ["if_statement", "if_clause"],
        "condition_blocks": ["statement_block"]
    }
}
